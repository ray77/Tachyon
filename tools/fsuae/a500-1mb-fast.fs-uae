# WhatsA500 target machine: Amiga 500, OCS, Kickstart 1.3, 512 KiB Chip + 1 MiB Fast (no slow RAM).
# The hard drive directory (DH0) is supplied on the command line by tools/run-fsuae.sh.
[config]
amiga_model = A500
kickstart_file = $HOME/Documents/FS-UAE/Kickstarts/kick13-34.5-a500.rom
chip_memory = 512
slow_memory = 0
fast_memory = 1024
accuracy = 1
floppy_drive_0 = $HOME/Documents/FS-UAE/Floppies/wb133-boot.adf
floppy_drive_count = 1
window_width = 640
window_height = 512
fullscreen = 0
video_sync = 0
zoom = auto
